{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SmartAIAgent;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "AI": {
    "Provider": "Ollama",
    "BaseUrl": "http://localhost:11434",
    "Model": "CONFIGURED_MODEL",
    "TimeoutSeconds": 120,
    "Temperature": 0.2
  },
  "RequirementAnalysis": {
    "MaxAutomaticRetries": 2,
    "TitleMaxLength": 200,
    "DescriptionMaxLength": 4000,
    "ListItemMaxLength": 500,
    "MaxListItems": 20,
    "ErrorMessageMaxLength": 500
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
